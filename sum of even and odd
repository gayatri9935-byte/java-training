import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();

        int evenSum = 0;
        int oddSum = 0;

        for (int i = 1; i <= n; i++) {
            if (i % 2 == 0) {
                evenSum = evenSum + i;
            } else {
                oddSum = oddSum + i;
            }
        }

        System.out.println("Final Even Sum = " + evenSum);
        System.out.println("Final Odd Sum = " + oddSum);
        System.out.println(evenSum+oddSum);
    }
}
