import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int n;
        Scanner m = new Scanner(System.in);
        n = m.nextInt();
        for(int i = 1; i <= 10; i++)
        {
            int multiply = i * n;
            System.out.println(i + "*" + n + "=" + multiply);
        }
    }
}
