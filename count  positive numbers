import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc= new Scanner (System.in);
        int n=sc.nextInt();
        int count=0;
        int[] ar= new int[50];
        for (int i=0;i<n;i++){
            ar[i]=sc.nextInt();
            if(ar[i]>0){
                count++;
            }
        }
        System.out.println(count);
    }
}
