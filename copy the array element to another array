import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int arr[]=new int [100];
        int rr[]=new int[100];
        for(int i=0;i<n;i++){
            arr[i]=sc.nextInt();
            rr[i]=arr[i];
            System.out.print(rr[i]+" ");
        }
    }
} 
