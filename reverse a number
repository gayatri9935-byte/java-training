import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int n;
        int reverse=0;
        Scanner sc= new Scanner (System.in);
        n=sc.nextInt();
        while(n>0)
        {
            int d=n%10;
            reverse=reverse*10+d;
            n=n/10;
        }
        System.out.print(reverse);
        
    }
}
