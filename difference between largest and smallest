import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc= new Scanner (System.in);
        int n=sc.nextInt();
        int[] ar= new int[50];
        int diff=0;
        for (int i=0;i<n;i++){
            ar[i]=sc.nextInt();
        }
        int lar=ar[0];
        for(int i=1;i<n;i++)
        {
            if(ar[i]>lar){
                lar=ar[i];
            }
        }
        int small=ar[0];
        for(int i=1;i<n;i++)
        {
            if(ar[i]<small){
                small=ar[i];
                
            }
        }
        diff=lar-small;
        
        System.out.print(diff);
    }
}
