import java.util.*;
public class Solution{
  public static void main(String[] args){
    Scanner s=new Scanner (System.in);
    int n=s.nextInt();
    int original=n;
    int result=0;
    while(n>0)
    {
    int lastnum=n%10;
    result= result+lastnum*lastnum*lastnum;
    n=n/10;
    }
    if(result==original){
    System.out.println("Armstrong num");
    }
    else 
    {
      System.out.println("Not Armstrong num");
    }
  }
}
