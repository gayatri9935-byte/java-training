import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc= new Scanner (System.in);
        int n=sc.nextInt();
        int[] ar= new int[50];
        int sum=0;
        for (int i=0;i<n;i++){
            ar[i]=sc.nextInt();
            sum=sum+ar[i];
        }
        System.out.print(sum);
    }
