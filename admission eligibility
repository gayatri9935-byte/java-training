import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int age, mark;
        Scanner el = new Scanner(System.in);
        age = el.nextInt();
        mark = el.nextInt();

        if (age >= 18) {
            if (mark >= 40) {
                System.out.println("Eligible");
            } else {
                System.out.println("Not Eligible");
            }
        } else {
            System.out.println("Not Eligible");
        }
    }
}
