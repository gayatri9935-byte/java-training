import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc= new Scanner (System.in);
        int n=sc.nextInt();
        int sum=0;
        int avg=0;
        int[] ar= new int[50];
        for (int i=0;i<n;i++){
          ar[i]=sc.nextInt();
            sum=sum+ar[i];
            avg=sum/n;
        }
        System.out.println(avg);
    }
}
