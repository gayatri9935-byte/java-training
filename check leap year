import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        int N;
        Scanner yr = new Scanner(System.in);
        N = yr.nextInt();

        if(N % 4 == 0)
        {
            if(N % 100 == 0)
            {
                if(N % 400 == 0){
                    System.out.println("Leap Year");
                }
                else{
                    System.out.println("Not Leap Year");
                }
            }
            else{
                System.out.println("Leap Year");
            }
        }
        else
        {
            System.out.println("Not Leap Year");
        }
    }
}
